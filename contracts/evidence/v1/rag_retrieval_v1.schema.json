{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-customs.local/contracts/rag_retrieval_v1.schema.json",
  "title": "Customs Evidence Retrieval API v1",
  "description": "Wire contract shared by the AI Agent and Evidence Service. A document validates as either a retrieve request or a retrieve response.",
  "oneOf": [
    { "$ref": "#/$defs/RetrieveRequest" },
    { "$ref": "#/$defs/RetrieveResponse" }
  ],
  "$defs": {
    "TradeType": {
      "type": "string",
      "enum": ["import", "export"]
    },
    "NullableString": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "NullableDate": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "NullableHs6": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{6}$" },
        { "type": "null" }
      ]
    },
    "NullableHsk10": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{10}$" },
        { "type": "null" }
      ]
    },
    "RetrieveItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "description",
        "hs_code",
        "origin_country",
        "destination_country"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "hs_code": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        },
        "origin_country": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z]{2}$" },
            { "type": "null" }
          ]
        },
        "destination_country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "RetrieveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "case_id",
        "review_run_id",
        "review_as_of",
        "jurisdiction",
        "trade_type",
        "top_k",
        "items"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "case_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "review_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "review_as_of": { "type": "string", "format": "date" },
        "jurisdiction": { "const": "KR" },
        "trade_type": { "$ref": "#/$defs/TradeType" },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 100 },
        "uploaded_requirement_document_codes": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        },
        "validation_issue_codes": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        },
        "query_intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "default": "required_import_documents"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/RetrieveItem" }
        }
      }
    },
    "RetrievalError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_record_id",
        "source_type",
        "item_id",
        "title",
        "text",
        "law_id",
        "law_name",
        "article_no",
        "source_uri",
        "valid_from",
        "valid_to",
        "version_hash",
        "matched_hs_code",
        "trade_type",
        "required_document_code",
        "required_document_name",
        "agencies",
        "retrieval_methods",
        "eligibility",
        "score",
        "raw_scores"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^ev_[a-f0-9]{64}$" },
        "source_record_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_type": {
          "type": "string",
          "enum": ["law_article", "customs_requirement", "hsk_entry", "notice"]
        },
        "item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "text": { "type": "string", "minLength": 1 },
        "law_id": { "$ref": "#/$defs/NullableString" },
        "law_name": { "$ref": "#/$defs/NullableString" },
        "article_no": { "$ref": "#/$defs/NullableString" },
        "source_uri": { "type": "string", "format": "uri", "minLength": 1 },
        "valid_from": { "$ref": "#/$defs/NullableDate" },
        "valid_to": { "$ref": "#/$defs/NullableDate" },
        "version_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "matched_hs_code": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]{6}$" },
            { "type": "string", "pattern": "^[0-9]{10}$" },
            { "type": "null" }
          ]
        },
        "trade_type": { "$ref": "#/$defs/TradeType" },
        "required_document_code": { "$ref": "#/$defs/NullableString" },
        "required_document_name": { "$ref": "#/$defs/NullableString" },
        "agencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "uniqueItems": true
        },
        "retrieval_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["exact_hs", "dense", "bm25", "graph"]
          }
        },
        "eligibility": {
          "type": "string",
          "enum": ["finding", "supporting", "blocked"]
        },
        "score": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "raw_scores": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "RetrieveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "hs_resolution",
        "resolved_hsk10",
        "candidate_hsk10s",
        "coverage",
        "requirements_found",
        "evidence",
        "errors"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hs_resolution": {
          "type": "string",
          "enum": ["exact", "unique_descendant", "ambiguous", "invalid", "missing"]
        },
        "resolved_hsk10": { "$ref": "#/$defs/NullableHsk10" },
        "candidate_hsk10s": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]{10}$" }
        },
        "coverage": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"]
        },
        "requirements_found": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/RetrievalError" }
        }
      }
    },
    "RetrieveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "status",
        "knowledge_snapshot_id",
        "results"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": {
          "type": "string",
          "enum": ["ok", "partial", "failed"]
        },
        "knowledge_snapshot_id": { "$ref": "#/$defs/NullableString" },
        "results": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/RetrieveResult" }
        },
        "errors": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/RetrievalError" }
        }
      }
    }
  }
}
