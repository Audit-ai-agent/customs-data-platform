{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://customs-data-platform.invalid/contracts/evidence/v2/readiness_v2.schema.json",
  "title": "Evidence Runtime Readiness v2",
  "$ref": "#/$defs/EvidenceRuntimeReadiness",
  "$defs": {
    "EvidenceRuntimeReleaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "retrieval_schema_version",
        "provider_release",
        "provider_revision",
        "provider_build_sha256",
        "retrieval_schema_sha256",
        "provider_source_manifest_sha256",
        "knowledge_generation_id",
        "knowledge_generation_attestation_sha256",
        "knowledge_source_manifest_sha256",
        "model_manifest_sha256",
        "index_config_sha256",
        "evaluation_report_sha256",
        "seal_attestation_sha256",
        "knowledge_snapshot_id",
        "supported_review_as_of",
        "runtime_release_sha256"
      ],
      "properties": {
        "contract": {
          "const": "evidence-runtime-release"
        },
        "schema_version": {
          "const": "2.0"
        },
        "retrieval_schema_version": {
          "const": "1.0"
        },
        "provider_release": {
          "const": "evidence-api-v1.2.0"
        },
        "provider_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "provider_build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieval_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider_source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "knowledge_generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "knowledge_generation_attestation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "knowledge_source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluation_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seal_attestation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "knowledge_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "supported_review_as_of": {
          "type": "string",
          "format": "date"
        },
        "runtime_release_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "EvidenceRuntimeReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_runtime_release"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "evidence_runtime_release": {
          "$ref": "#/$defs/EvidenceRuntimeReleaseIdentity"
        }
      }
    }
  }
}
