{
  "$id": "https://customs-data-platform.invalid/contracts/evidence/v3/trusted_reviewer_lock_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "evidence-domain-reviewer-trust-store-lock",
      "title": "Contract",
      "type": "string"
    },
    "release_state": {
      "enum": [
        "unreleased",
        "approved"
      ],
      "title": "Release State",
      "type": "string"
    },
    "reviewer_trust_store_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewer Trust Store Sha256"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trust_store_release": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Trust Store Release",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "release_state",
    "trust_store_release",
    "reviewer_trust_store_sha256"
  ],
  "title": "TrustedReviewerStoreLock",
  "type": "object"
}
