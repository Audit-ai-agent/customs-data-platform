{
  "$defs": {
    "AgentConformanceProof": {
      "additionalProperties": false,
      "properties": {
        "consumer_lock": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "report": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "consumer_lock",
        "report"
      ],
      "title": "AgentConformanceProof",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ContainerReleaseProof": {
      "additionalProperties": false,
      "properties": {
        "build_provenance": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "sbom": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "image_digest",
        "sbom",
        "build_provenance"
      ],
      "title": "ContainerReleaseProof",
      "type": "object"
    },
    "EvaluationProof": {
      "additionalProperties": false,
      "properties": {
        "approval_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Sha256",
          "type": "string"
        },
        "bundle_path": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Bundle Path",
          "type": "string"
        },
        "gold_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gold Sha256",
          "type": "string"
        },
        "mock_count": {
          "const": 0,
          "title": "Mock Count",
          "type": "integer"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "unexpected_skips": {
          "const": 0,
          "title": "Unexpected Skips",
          "type": "integer"
        }
      },
      "required": [
        "bundle_path",
        "report_sha256",
        "approval_sha256",
        "gold_sha256",
        "unexpected_skips",
        "mock_count"
      ],
      "title": "EvaluationProof",
      "type": "object"
    },
    "GenerationReleaseProof": {
      "additionalProperties": false,
      "properties": {
        "active_attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Active Attestation Sha256",
          "type": "string"
        },
        "changed_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z$",
          "title": "Changed At",
          "type": "string"
        },
        "epoch": {
          "exclusiveMinimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "evaluation": {
          "$ref": "#/$defs/EvaluationProof"
        },
        "generation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Generation Id",
          "type": "string"
        },
        "index_config": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "index_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Index Config Sha256",
          "type": "string"
        },
        "model_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "model_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Sha256",
          "type": "string"
        },
        "seal_attestation": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "seal_attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Seal Attestation Sha256",
          "type": "string"
        },
        "source_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        },
        "stores": {
          "items": {
            "$ref": "#/$defs/StoreProof"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Stores",
          "type": "array"
        }
      },
      "required": [
        "generation_id",
        "epoch",
        "changed_at",
        "source_manifest",
        "source_manifest_sha256",
        "model_manifest",
        "model_manifest_sha256",
        "index_config",
        "index_config_sha256",
        "stores",
        "evaluation",
        "seal_attestation",
        "seal_attestation_sha256",
        "active_attestation_sha256"
      ],
      "title": "GenerationReleaseProof",
      "type": "object"
    },
    "GitTagProvenance": {
      "additionalProperties": false,
      "properties": {
        "annotated": {
          "const": true,
          "title": "Annotated",
          "type": "boolean"
        },
        "repository": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        },
        "source_commit_clean": {
          "const": true,
          "title": "Source Commit Clean",
          "type": "boolean"
        },
        "tag_name": {
          "pattern": "^evidence-api-v3\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$",
          "title": "Tag Name",
          "type": "string"
        },
        "tag_object_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tag Object Sha",
          "type": "string"
        },
        "tag_object_type": {
          "const": "tag",
          "title": "Tag Object Type",
          "type": "string"
        },
        "tag_target_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tag Target Sha",
          "type": "string"
        },
        "tag_target_type": {
          "const": "commit",
          "title": "Tag Target Type",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "tag_name",
        "annotated",
        "tag_object_type",
        "tag_target_type",
        "tag_object_sha",
        "tag_target_sha",
        "source_commit",
        "source_commit_clean"
      ],
      "title": "GitTagProvenance",
      "type": "object"
    },
    "PolicyReleaseProof": {
      "additionalProperties": false,
      "properties": {
        "coverage_matrix": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "policy": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "policy_release": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Release",
          "type": "string"
        },
        "reviewer_trust_store_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reviewer Trust Store Sha256",
          "type": "string"
        },
        "trusted_reviewer_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trusted Reviewer Lock Sha256",
          "type": "string"
        },
        "trusted_reviewers": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "verified_approval_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verified Approval Sha256",
          "type": "string"
        }
      },
      "required": [
        "policy_release",
        "policy",
        "coverage_matrix",
        "trusted_reviewers",
        "trusted_reviewer_lock_sha256",
        "reviewer_trust_store_sha256",
        "verified_approval_sha256"
      ],
      "title": "PolicyReleaseProof",
      "type": "object"
    },
    "ProviderReleaseProof": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "const": "production",
          "title": "Context",
          "type": "string"
        },
        "context_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Manifest Sha256",
          "type": "string"
        },
        "context_path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Context Path",
          "type": "string"
        },
        "provider_build_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Build Sha256",
          "type": "string"
        },
        "provider_release": {
          "const": "evidence-api-v1.2.0",
          "title": "Provider Release",
          "type": "string"
        },
        "provider_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Source Manifest Sha256",
          "type": "string"
        },
        "release_provenance_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Provenance Schema Sha256",
          "type": "string"
        },
        "requirement_policy_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requirement Policy Schema Sha256",
          "type": "string"
        },
        "runtime_identity": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "v3_readiness_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "V3 Readiness Schema Sha256",
          "type": "string"
        },
        "v3_retrieval_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "V3 Retrieval Schema Sha256",
          "type": "string"
        }
      },
      "required": [
        "context",
        "context_path",
        "context_manifest_sha256",
        "provider_release",
        "provider_revision",
        "provider_build_sha256",
        "provider_source_manifest_sha256",
        "runtime_identity",
        "v3_retrieval_schema_sha256",
        "v3_readiness_schema_sha256",
        "requirement_policy_schema_sha256",
        "release_provenance_schema_sha256"
      ],
      "title": "ProviderReleaseProof",
      "type": "object"
    },
    "RollbackProof": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "rollback_generation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rollback Generation Id",
          "type": "string"
        },
        "rollback_image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rollback Image Digest",
          "type": "string"
        }
      },
      "required": [
        "rollback_image_digest",
        "rollback_generation_id",
        "report"
      ],
      "title": "RollbackProof",
      "type": "object"
    },
    "SecurityProof": {
      "additionalProperties": false,
      "properties": {
        "dependency_audit": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "sast": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "secret_scan": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "secret_scan",
        "dependency_audit",
        "sast"
      ],
      "title": "SecurityProof",
      "type": "object"
    },
    "StoreProof": {
      "additionalProperties": false,
      "properties": {
        "attestation": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attestation Sha256",
          "type": "string"
        },
        "sealed_projection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sealed Projection Sha256",
          "type": "string"
        },
        "store_name": {
          "enum": [
            "postgresql",
            "qdrant",
            "neo4j"
          ],
          "title": "Store Name",
          "type": "string"
        }
      },
      "required": [
        "store_name",
        "attestation",
        "attestation_sha256",
        "sealed_projection_sha256"
      ],
      "title": "StoreProof",
      "type": "object"
    },
    "WorkflowProvenance": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "const": "success",
          "title": "Conclusion",
          "type": "string"
        },
        "event": {
          "const": "workflow_dispatch",
          "title": "Event",
          "type": "string"
        },
        "head_ref": {
          "maxLength": 200,
          "pattern": "^refs/tags/evidence-api-v3\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$",
          "title": "Head Ref",
          "type": "string"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "run_attempt": {
          "exclusiveMinimum": 0,
          "title": "Run Attempt",
          "type": "integer"
        },
        "run_id": {
          "exclusiveMinimum": 0,
          "title": "Run Id",
          "type": "integer"
        },
        "workflow_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workflow File Sha256",
          "type": "string"
        },
        "workflow_path": {
          "maxLength": 200,
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$",
          "title": "Workflow Path",
          "type": "string"
        },
        "workflow_ref": {
          "maxLength": 400,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/evidence-v3-release-bundle\\.yml@refs/tags/evidence-api-v3\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$",
          "title": "Workflow Ref",
          "type": "string"
        },
        "workflow_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Workflow Sha",
          "type": "string"
        }
      },
      "required": [
        "workflow_path",
        "workflow_sha",
        "workflow_file_sha256",
        "workflow_ref",
        "head_ref",
        "head_sha",
        "run_id",
        "run_attempt",
        "event",
        "conclusion"
      ],
      "title": "WorkflowProvenance",
      "type": "object"
    }
  },
  "$id": "https://customs-data-platform.invalid/contracts/evidence/v3/release_provenance_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_conformance": {
      "$ref": "#/$defs/AgentConformanceProof"
    },
    "container": {
      "$ref": "#/$defs/ContainerReleaseProof"
    },
    "contract": {
      "const": "evidence-v3-release-provenance",
      "title": "Contract",
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/GenerationReleaseProof"
    },
    "git": {
      "$ref": "#/$defs/GitTagProvenance"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PolicyReleaseProof"
    },
    "provider": {
      "$ref": "#/$defs/ProviderReleaseProof"
    },
    "release_state": {
      "enum": [
        "release_candidate",
        "released"
      ],
      "title": "Release State",
      "type": "string"
    },
    "rollback": {
      "$ref": "#/$defs/RollbackProof"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "security": {
      "$ref": "#/$defs/SecurityProof"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowProvenance"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "release_state",
    "created_at",
    "git",
    "workflow",
    "provider",
    "generation",
    "policy",
    "security",
    "container",
    "rollback",
    "agent_conformance",
    "manifest_sha256"
  ],
  "title": "EvidenceV3ReleaseProvenance",
  "type": "object"
}
