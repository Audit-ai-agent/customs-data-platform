        {"scope": "export_declaration", "title": "수출 신고", "directions": ["export"], "keywords": ["수출신고", "수출 신고"], "development_excerpt": "수출 신고에는 물품과 거래에 관한 정확한 정보 및 관련 요건 확인이 필요할 수 있습니다.", "required_source_ids": ["v2_law_customs_act", "v2_law_customs_act_body", "v2_kcs_export_clearance"]}
      ]
