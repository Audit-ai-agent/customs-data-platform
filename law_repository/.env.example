# Optional local Data settings. Normal setup creates profile-specific values
# under workspace _local; do not copy this file into a shared secret bundle.

# --- Postgres (시간버전 원장) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=trade_doc
POSTGRES_USER=trade
POSTGRES_PASSWORD=

# --- Qdrant (현행 인덱스) ---
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# --- Neo4j (그래프) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Personal Law API credential for functional-uat-3law only. Keep it in
# _local/profiles/functional-uat-3law/config.env, not this file.
LAW_API_OC=
