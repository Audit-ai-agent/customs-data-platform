# Python environments and generated files
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
dist/
build/

# Tests, coverage, and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv-cache/
.coverage
coverage.xml
htmlcov/
*.junit.xml

# Secrets. Example templates are intentionally tracked.
.env
.env.*
!.env.example
!**/.env.example
!**/.env.*.example

# Regenerable/local datasets. The checked-in HSK and CCCT reference snapshot
# are the bounded inputs used by local functional UAT; raw law responses are
# always recollected into the workspace _local boundary.
*.npy
**/data/raw/
**/data/ccct_*
!law_repository/data/ccct_progress.jsonl

# Shared workspace state. These paths are intentionally outside the repository
# in normal use, but ignoring them here protects an accidental nested checkout.
_local/
_artifacts/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
